# ============ 데이터베이스 ============
# MySQL / PostgreSQL / Firebase 등 사용하는 데이터베이스에 따라 설정

# 예: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/goyang_mice

# 예: MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/goyang_mice

# 예: Firebase (Supabase)
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres?schema=public

DATABASE_URL=

# ============ API 설정 ============
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============ 이메일 ============
# Nodemailer, SendGrid, Amazon SES 등
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@goyangmice.kr

# ============ 인증 ============
# NextAuth.js, JWT 등
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ============ 파일 업로드 ============
# AWS S3, Cloudinary, Local 등
UPLOAD_SERVICE=local
UPLOAD_PATH=/public/uploads

# ============ 개발 환경 ============
NODE_ENV=development
